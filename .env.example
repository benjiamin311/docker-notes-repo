# 镜像地址：发布后改成 ghcr.io/benjiamin311/docker-notes-repo:latest
IMAGE=ghcr.io/benjiamin311/docker-notes-repo:latest

# 宿主机端口
HOST_PORT=8080

# 采集间隔（秒）
REFRESH_SECONDS=300

# 时区
TZ=Asia/Shanghai

# 开启 HTTP Basic 认证（留空则关闭）：user:pass
BASIC_AUTH=

# 允许在界面里启停容器 / 执行命令（1=开）。开启前必须先设置 BASIC_AUTH
ALLOW_ACTIONS=0
ALLOW_EXEC=0

# compose 文件在宿主机上的目录（只读挂载）
COMPOSE_DIR=/opt
# 挂进容器后的路径（保持和 PATH_MAP 的后半段一致）
COMPOSE_MOUNT=/mnt/host-compose
# 宿主机路径:容器路径，用于把 compose 文件路径映射到挂载点
PATH_MAP=/opt:/mnt/host-compose
